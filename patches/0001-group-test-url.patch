 }
 
+/// Delay records the core keeps per test URL (`extra` in the proxies API).
+class ClashProxyDelayState: Codable {
+    let alive: Bool?
+    let history: [ClashProxySpeedHistory]?
+}
+
 class ClashProxy: Codable {
 	let id: String?
     let name: ClashProxyName
@@ -131,6 +137,9 @@ class ClashProxy: Codable {
