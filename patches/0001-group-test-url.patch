     weak var enclosingResp: ClashProxyResp?
     weak var enclosingProvider: ClashProvider?
 	
@@ -173,6 +182,7 @@ class ClashProxy: Codable {
 
     private enum CodingKeys: String, CodingKey {
         case type, all, history, now, name, udp, xudp, tfo, id, alive, hidden
+        case testUrl, expectedStatus, extra
     }
 
     lazy var maxProxyNameLength: CGFloat = {
@@ -196,6 +206,43 @@ class ClashProxy: Codable {
     }()
 }
 
+/// Which URL a group benchmarks with and whose delay records it shows: its
+/// own `url` from the config, otherwise the global benchmark URL.
+struct ProxyDelaySource {
+    let url: String
+    /// Set when the group has its own `url`; then records of other URLs are
+    /// never shown in its place.
+    let isGroupUrl: Bool
+
+    init(group: ClashProxy) {
+        // mihomo leaves testUrl empty for select groups without their own url
+        if let testUrl = group.testUrl, !testUrl.isEmpty {
+            url = testUrl
+            isGroupUrl = true
+        } else {
+            url = ConfigManager.shared.benchMarkUrl
+            isGroupUrl = false
+        }
+    }
+}
+
+extension ClashProxy {
+    /// Delay records for the source's URL. Without any, falls back to the
+    /// merged history of all URLs unless the group has its own url; cores
+    /// that don't report per-URL records always get the merged history.
+    func delayHistory(from source: ProxyDelaySource) -> [ClashProxySpeedHistory] {
+        guard let extra else { return history }
+        if let state = extra[source.url] { return state.history ?? [] }
+        return source.isGroupUrl ? [] : history
+    }
+
+    func isAlive(from source: ProxyDelaySource) -> Bool? {
+        guard let extra else { return alive }
+        if let state = extra[source.url] { return state.alive }
+        return source.isGroupUrl ? nil : alive
+    }
+}
+
 class ClashProxyResp {
     var proxies: [ClashProxy]
 
